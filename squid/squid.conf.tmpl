# Generated by the Hermetarium supervisor. Per-habitat ACL file.
# Squid 6 requires at least one non-intercept http_port.
http_port 127.0.0.1:3129
# Local probe origin is reverse-proxied (avoids intercept hairpin on TAP).
http_port 0.0.0.0:80 accel defaultsite={{.ProbeHost}} vhost
http_port 0.0.0.0:{{.ListenPort}} intercept
visible_hostname hermetarium
pid_filename {{.LogDir}}/squid.pid
coredump_dir /tmp
cache_log {{.LogDir}}/cache.log
access_log stdio:{{.LogDir}}/access.log squid
logfile_rotate 0
shutdown_lifetime 1 seconds
connect_timeout 2 seconds
cache_effective_user squid
dns_v4_first on

acl probe dstdomain {{.ProbeHost}}
acl probe_dst dst 172.16.0.1
acl probe_dst dst 127.0.0.1
cache_peer 127.0.0.1 parent {{.ProbePort}} 0 no-query no-digest originserver name=probeorigin
cache_peer_access probeorigin allow all
always_direct deny all
never_direct allow all
http_access allow probe
http_access allow probe_dst
http_access deny all
