# Generated by the Hermetarium supervisor. Per-habitat ACL file.
# Squid 6 requires at least one non-intercept http_port.
http_port 127.0.0.1:3129
{{if .ProbeHost}}
# Local probe origin is reverse-proxied (avoids intercept hairpin on TAP).
http_port 0.0.0.0:80 accel defaultsite={{.ProbeHost}} vhost
{{end}}
# Operator inbound: reverse-proxied to the inhabitant HTTP server.
http_port 0.0.0.0:{{.InboundPort}} accel defaultsite=echo.hermetarium.test vhost
http_port 0.0.0.0:{{.ListenPort}} intercept
visible_hostname hermetarium
pid_filename {{.LogDir}}/squid.pid
coredump_dir /tmp
cache_log {{.LogDir}}/cache.log
logformat htm %ts.%03tu %6tr %>a %Ss/%03>Hs %<st %rm %ru %[un %Sh/%<a %mt %>lp
access_log stdio:{{.LogDir}}/access.log htm
logfile_rotate 0
shutdown_lifetime 1 seconds
connect_timeout 2 seconds
cache_effective_user proxy
dns_v4_first on
cache deny all

{{if .ProbeHost}}
acl probe dstdomain {{.ProbeHost}}
acl probe_dst dst 172.16.0.1
acl probe_dst dst 127.0.0.1
{{end}}
acl inbound myport {{.InboundPort}}
{{if .ProbeHost}}
cache_peer 127.0.0.1 parent {{.ProbePort}} 0 no-query no-digest originserver name=probeorigin
{{end}}
cache_peer {{.InhabitantIP}} parent {{.EchoPort}} 0 no-query no-digest originserver name=inhabitant
{{if .VendorHost}}
acl vendorhost dstdomain {{.VendorHost}}
cache_peer {{.VendorPeer}} parent {{.VendorPort}} 0 no-query no-digest originserver{{if .VendorSSL}} ssl sslflags=DONT_VERIFY_PEER{{end}} name=vendor
cache_peer_access vendor allow vendorhost
cache_peer_access vendor deny all
{{if .ProbeHost}}
cache_peer_access probeorigin deny vendorhost
{{end}}
request_header_access x-api-key deny all
request_header_access Authorization deny all
request_header_add x-api-key "{{.VendorKey}}" vendorhost
request_header_add Authorization "Bearer {{.VendorKey}}" vendorhost
{{end}}
cache_peer_access inhabitant allow inbound
cache_peer_access inhabitant deny all
{{if .ProbeHost}}
cache_peer_access probeorigin deny inbound
cache_peer_access probeorigin allow all
{{end}}
always_direct deny all
never_direct allow all
http_access allow inbound
{{if .ProbeHost}}
http_access allow probe
http_access allow probe_dst
{{end}}
{{if .VendorHost}}
http_access allow vendorhost
{{end}}
http_access deny all
